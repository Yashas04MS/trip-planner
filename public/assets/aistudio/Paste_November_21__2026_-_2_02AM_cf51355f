<script>
  (function() {
    // Cadence Slider reactivity
    const slider = document.getElementById('cadence-slider');
    const display = document.getElementById('cadence-display');
    if (slider && display) {
      slider.addEventListener('input', function(e) {
        const val = parseFloat(e.target.value).toFixed(2);
        let label = 'Normal';
        if (val < 0.95) label = 'Relaxed';
        else if (val > 1.05 && val <= 1.25) label = 'Brisk';
        else if (val > 1.25) label = 'Rapid';
        display.textContent = label + ' (' + val + 'x)';
      });
    }

    // Voice Card Selection
    const voiceCards = document.querySelectorAll('.voice-card');
    voiceCards.forEach(card => {
      card.addEventListener('click', function(e) {
        if (e.target.closest('.preview-btn')) return; // let sample preview handle itself
        
        voiceCards.forEach(c => {
          c.classList.remove('ring-1', 'ring-accent-primary/20');
          const badge = c.querySelector('.px-2.py-0.5');
          if (badge && badge.textContent.includes('Active')) badge.remove();
          const iconContainer = c.querySelector('.w-8.h-8');
          if (iconContainer) {
            iconContainer.className = 'w-8 h-8 rounded-full bg-bg-elevated text-text-muted flex items-center justify-center';
            iconContainer.innerHTML = '<span class="material-symbols-outlined text-[16px]">radio_button_unchecked</span>';
          }
          const wave = c.querySelector('.bg-bg-elevated.rounded-lg');
          if (wave) {
            wave.classList.add('opacity-70');
            wave.querySelectorAll('span').forEach(bar => {
              bar.classList.remove('bg-accent-primary');
              bar.classList.add('bg-text-secondary');
            });
          }
        });

        // Activate clicked card
        this.classList.add('ring-1', 'ring-accent-primary/20');
        const iconContainer = this.querySelector('.w-8.h-8');
        if (iconContainer) {
          iconContainer.className = 'w-8 h-8 rounded-full bg-accent-primary text-accent-primary-ink flex items-center justify-center shadow-sm';
          iconContainer.innerHTML = '<span class="material-symbols-outlined text-[16px]">check</span>';
        }
        const titleArea = this.querySelector('.flex.items-center.gap-space-xs');
        if (titleArea && !titleArea.querySelector('.bg-accent-soft')) {
          const activeTag = document.createElement('span');
          activeTag.className = 'px-2 py-0.5 rounded-full bg-accent-soft text-accent-primary font-label-code text-[11px] font-medium';
          activeTag.textContent = 'Active';
          titleArea.appendChild(activeTag);
        }
        const wave = this.querySelector('.bg-bg-elevated.rounded-lg');
        if (wave) {
          wave.classList.remove('opacity-70');
          wave.querySelectorAll('span').forEach(bar => {
            bar.classList.remove('bg-text-secondary');
            bar.classList.add('bg-accent-primary');
          });
        }
      });
    });

    // Sample Play simulation
    const playButtons = document.querySelectorAll('.preview-btn');
    playButtons.forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        const icon = this.querySelector('.material-symbols-outlined');
        const label = this.querySelector('span:last-child');
        const originalText = label.textContent;

        if (icon.textContent === 'play_circle') {
          icon.textContent = 'graphic_eq';
          label.textContent = 'Playing...';
          setTimeout(() => {
            icon.textContent = 'play_circle';
            label.textContent = originalText;
          }, 2400);
        }
      });
    });
  })();
</script></main></div></body></html>