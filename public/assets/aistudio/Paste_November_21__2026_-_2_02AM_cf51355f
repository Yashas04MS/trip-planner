<script>
    document.addEventListener('DOMContentLoaded', () => {
      const voiceOrb = document.getElementById('voice-orb');
      const halo = document.getElementById('orb-pulse-halo');
      const startVoiceBtns = [
        document.getElementById('hero-start-voice'),
        document.getElementById('cta-bottom-voice')
      ];

      let isListening = true;

      function toggleVoiceOrb() {
        isListening = !isListening;
        if (isListening) {
          halo.classList.remove('opacity-0');
          halo.classList.add('opacity-30', 'animate-ping');
          voiceOrb.classList.add('scale-105');
        } else {
          halo.classList.remove('opacity-30', 'animate-ping');
          halo.classList.add('opacity-0');
          voiceOrb.classList.remove('scale-105');
        }
      }

      if (voiceOrb) {
        voiceOrb.addEventListener('click', toggleVoiceOrb);
      }

      startVoiceBtns.forEach(btn => {
        if (btn) {
          btn.addEventListener('click', () => {
            // Scroll smoothly to the interactive orb stage on hero
            window.scrollTo({ top: 0, behavior: 'smooth' });
            if (!isListening) toggleVoiceOrb();
          });
        }
      });
    });
